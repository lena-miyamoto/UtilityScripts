{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "<YOUR-AUTH-TOKEN>",
    "ANTHROPIC_BASE_URL": "https://api.deepseek.com/anthropic",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "deepseek-v4-pro[1m]",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "deepseek-v4-flash",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "deepseek-v4-pro[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "deepseek-v4-pro[1m]",
    "ANTHROPIC_MODEL": "deepseek-v4-pro[1m]",
    "CLAUDE_CODE_TMPDIR": "<USER-HOME-DIR>/.claude/tmp",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "64000",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "200000",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "193000",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT": "1"
  },
  "permissions": {
    "deny": [
      "Artifact",
      "DesignSync",
      "NotebookEdit",
      "SendMessage",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "SendUserFile",
      "CronCreate",
      "CronDelete",
      "CronList"
    ],
    "defaultMode": "default"
  },
  "model": "opus",
  "disableClaudeAiConnectors": true,
  "disableBundledSkills": true,
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-sync --project ~/.claude/hooks/tool-permissions tool-permissions",
            "timeout": 3000
          }
        ]
      }
    ]
  },
  "disableRemoteControl": true,
  "disableWorkflows": true,
  "disableArtifact": true,
  "statusLine": {
    "type": "command",
    "command": "npx -y tsx ~/.claude/statusline.ts"
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "npx -y tsx ~/.claude/subagent-statusline.ts"
  },
  "disableSideloadFlags": true,
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": ["Processing"]
  },
  "effortLevel": "high",
  "modelSettings": {
    "deepseek-v4-pro[1m]": {
      "effortLevel": "high"
    }
  },
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "disableAutoMode": "disable",
  "theme": "auto",
  "useAutoModeDuringPlan": false,
  "disableDeepLinkRegistration": "disable"
}
