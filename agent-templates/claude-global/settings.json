{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "<YOUR-AUTH-TOKEN>",
    "ANTHROPIC_BASE_URL": "https://api.deepseek.com/anthropic",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "deepseek-flash",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "deepseek-v4-pro",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "deepseek-v4-pro",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "deepseek-v4-pro",
    "ANTHROPIC_DEFAULT_MODEL": "deepseek-flash",
    "FORCE_HYPERLINK": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_RETRY_WATCHDOG": "1",
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "64000",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "200000",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "193000",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT": "1"
  },
  "permissions": {
    "allow": [
      "Skill(dev-utils:csv-tool)",
      "Skill(dev-utils:apply-fixes)",
      "Skill(dev-utils:optimize-repo)",
      "Skill(dev-utils:review-changeset)",
      "Skill(dev-utils:compress-instructions)",
      "Skill(statusline:install-statusline)"
    ],
    "deny": [
      "Artifact",
      "DesignSync",
      "NotebookEdit",
      "SendMessage",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "SendUserFile",
      "CronCreate",
      "CronDelete",
      "CronList"
    ],
    "defaultMode": "default"
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": ["Processing"]
  },
  "disableClaudeAiConnectors": true,
  "disableBundledSkills": true,
  "disableRemoteControl": true,
  "disableWorkflows": true,
  "disableArtifact": true,
  "disableSideloadFlags": true,
  "autoMemoryEnabled": false,
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "disableAutoMode": "disable",
  "theme": "auto",
  "useAutoModeDuringPlan": false,
  "disableDeepLinkRegistration": "disable"
}
