{
  "$schema": "./hooks/tool-permissions/permissions.schema.json",
  "version": 1,
  "allow": {
    "Read": ["/?\\.agents/", "/?\\.claude/", "/?\\.github/"],
    "Write|Edit|MultiEdit|NotebookEdit": [
      "/?\\.agents/.*\\.md$",
      "^(?!~/\\.claude/).*\\.claude/.*\\.md$",
      "/?\\.github/.*\\.md$"
    ],
    "Read|Write|Edit|MultiEdit|NotebookEdit": ["^~/.claude/tmp/", "^/tmp/"],
    "WebSearch": [],
    "WebFetch": [
      "^https://([a-zA-Z0-9-]+\\.)*anthropic\\.com(:\\d+)?(/|$)",
      "^https://([a-zA-Z0-9-]+\\.)*claude\\.com(:\\d+)?(/|$)",
      "^https://api\\.github\\.com(:\\d+)?(/|$)"
    ],
    "Skill": [
      "^update-config$",
      "^compress-instructions$",
      "^handoff$",
      "^grill-(me|with-docs)$",
      "^code-review$",
      "^codebase-design$"
    ],
    "Bash": [
      "^node --(check|version)(\\s|$)",
      "^python3? --version(\\s|$)",
      "^pip3? (list|show|check|freeze)(\\s|$)",
      "^npm (ls|explain|view|info|outdated|audit)(?!.*\\bfix\\b)(\\s|$)",
      "^pnpm (list|why)(\\s|$)",
      "^p?npm (test|run(-script)? test)(\\s|$)",
      "^git (-C ['\\\"]?\\S+['\\\"]? )*(status|diff|log|show|branch|blame|rev-parse|tag|remote|describe|shortlog|ls-files|ls-tree|cat-file|reflog|grep|merge-base|rev-list|for-each-ref|cherry)(?!.*(--output|--ext-diff|--upload-pack|--open-files-in-pager|\\s-O|--delete\\b|\\s-D\\b))(\\s|$)",
      "^git (-C ['\\\"]?\\S+['\\\"]? )*(stash list|stash show)(\\s|$)",
      "^git (-C ['\\\"]?\\S+['\\\"]? )*config (--get|--list|--get-all|--get-regexp)(\\s|$)",
      "^git (-C ['\\\"]?\\S+['\\\"]? )*check-ignore(\\s)",
      "^git (-C ['\\\"]?\\S+['\\\"]? )*fetch(?!.*://)(\\s|$)",
      "^git (-C ['\\\"]?\\S+['\\\"]? )*worktree list(\\s|$)",
      "^git (-C ['\\\"]?\\S+['\\\"]? )*submodule status(\\s|$)",
      "^gh (auth )?status(\\s|$)",
      "^gh (pr|issue) (view|list|status)(\\s|$)",
      "^gh pr (diff|checks)(\\s|$)",
      "^gh (repo|run|release|workflow|gist|ruleset|project) (view|list)(\\s|$)",
      "^gh run watch(\\s|$)",
      "^gh (label|cache|variable|secret|ssh-key|gpg-key|extension) list(\\s|$)",
      "^gh api(?!.*--method\\s+(POST|PUT|PATCH|DELETE)\\b)\\s+['\"]?repos/[^/]+/[^/]+/(releases|tags|git/(ref/tags|tags|commits)|pulls|commits)(/|\\s|['\"]|$)",
      "^(realpath|basename|dirname|readlink)\\s",
      "^gio (list|info)(\\s|$)",
      "^(ls|tree|locate)(\\s|$)",
      "^(eza|exa)(\\s|$)",
      "^(which|where|whereis|type)\\s",
      "^fd(?!.*(\\s-x\\b|\\s-X\\b|--exec\\b|--exec-batch\\b))(\\s|$)",
      "^find(?!.*(-exec\\b|-execdir\\b|-delete\\b|-ok\\b|-okdir\\b|-fprintf?\\b|-fprint0\\b|-fls\\b))(\\s|$)",
      "^rg(?!.*--pre\\b)\\s",
      "^(grep|ag|fgrep|egrep)\\s",
      "^(ast-grep|sg) (run|scan|test)(?!.*(\\s-U\\b|--update-all\\b|--rewrite\\b))(\\s|$)",
      "^yq(?!.* -i(\\s|$))(?!.*(--inplace|--in-place)\\b)(\\s|$)",
      "^(jq|xq)\\s",
      "^(csvcut|csvformat|csvgrep|csvjoin|csvjson|csvlook|csvsort|csvstack|csvstat)(\\s|$)",
      "^sort(?!.*(--compress-program|--files0-from|--output|\\s-o\\b))(\\s|$)",
      "^(head|tail)(\\s|$)",
      "^(stat|file)\\s",
      "^(xxd|od|strings)(\\s|$)",
      "^(cat|bat|batcat|zcat|bzcat|xzcat|zstdcat)(\\s|$)",
      "^(uniq|cut|paste|tr|column|fmt|fold|rev|tac|nl|comm|wc)(\\s|$)",
      "^(tokei|scc)(\\s|$)",
      "^(difft?|delta|colordiff)(\\s|$)",
      "^(md5sum|sha1sum|sha256sum|sha512sum|b2sum)(\\s|$)",
      "^(dust|df|duf)(\\s|$)",
      "^du(\\s|$)",
      "^free(\\s|$)",
      "^(uname|hostname|whoami|id|date|uptime|lscpu|nproc|arch|locale|getconf)(\\s|$)",
      "^(lsblk|lspci|lsusb)(\\s|$)",
      "^(vmstat|iostat|mpstat)(\\s|$)",
      "^(ps|procs|pgrep)(\\s|$)",
      "^(ss|netstat)(\\s|$)",
      "^(ping|dig|nslookup|host)\\s",
      "^(ifconfig|whois)(\\s|$)",
      "^ip (addr|link|route|neigh|rule)(?!.* (add|del|delete|change|replace|set|flush|append|prepend)\\b)(\\s|$)",
      "^(traceroute|tracepath)\\s",
      "^(test|\\[\\[?|true|false|seq)(\\s|$)",
      "^(bc|expr)(\\s|$)",
      "^sleep\\s",
      "^cd(\\s|$)",
      "^pwd(\\s|$)",
      "^mkdir\\s",
      "^command(\\s+-[vV](\\s|$)|\\s*$)",
      "^(echo|printf)(\\s|$)",
      "^shellcheck\\s",
      "^systemctl (status|is-active|is-enabled|is-failed|list-units|list-unit-files|list-sockets|list-timers|show|cat)(\\s|$)",
      "^docker (ps|images|logs|version|info)(\\s|$)",
      "^kubectl (get|describe|logs|version|cluster-info)(?!.*\\bsecrets?\\b)(\\s|$)",
      "^unzip -l\\s",
      "^zipinfo(\\s|$)",
      "^7z (l|t)\\s"
    ]
  },
  "deny": {
    "Read|Write|Edit|MultiEdit|NotebookEdit": [
      "^~/\\.(ssh|aws|gnupg|kube|password-store|terraform\\.d|azure)/.*$",
      "^~/\\.config/(gh|op|gcloud|aws|doctl)/.*$",
      "^~/\\.config/git/credentials$",
      "^~/\\.(bash|zsh)_history$",
      "^~/\\.(git-credentials|npmrc|pypirc|netrc|vault-token)$",
      "^~/\\.docker/config\\.json$",
      "^~/\\.cargo/credentials\\.toml$",
      "^~/\\.gem/credentials$",
      "^~/\\.local/share/keyrings/.*$",
      "/?\\.env[^/]*$"
    ],
    "Bash": [
      "^ln\\s",
      "^(unlink|shred|wipe|srm|dd)\\s",
      "^(kill|killall|pkill)\\s",
      "^(chmod|chown|chgrp)\\s",
      "^(mkfs|truncate|fallocate)\\s",
      "^u?mount(\\s|$)",
      "^(reboot|shutdown)(\\s|$)",
      "^systemctl($|\\s+(?!(status|is-active|is-enabled|is-failed|list-units|list-unit-files|list-sockets|list-timers|show|cat|help)\\b))",
      "^crontab(\\s|$)",
      "^(ssh|scp|sftp|rsync)\\s",
      "^(nc|ncat|netcat|socat)\\s",
      "^(sudo|su|doas|pkexec)(\\s|$)",
      "^(docker|podman)($|\\s+(?!(ps|images|logs|inspect|version|info)\\b))",
      "^(dash|ash|ksh|mksh|tcsh|csh|fish|zsh|busybox)(\\s|$)",
      "^(powershell(\\.exe)?|pwsh|cmd(\\.exe)?|wsl)(\\s|$)",
      "^(ruby -e|bun -e|php -r|lua -e|R -e|Rscript -e)(\\s|$)",
      "^deno (eval|repl)(\\s|$)",
      "^csvpy(\\s|$)",
      "^git (-C ['\\\"]?\\S+['\\\"]? )*clean(\\s|$)",
      "^git (-C ['\\\"]?\\S+['\\\"]? )*reset --hard(\\s|$)",
      "^npm (install|ci|update|uninstall|exec|publish)(\\s|$)",
      "^(pnpx|yarn)(\\s|$)",
      "^pnpm (install|add|update|remove|exec|dlx|publish)(\\s|$)",
      "^pip3? install(\\s|$)",
      "^pipx (install|run)(\\s|$)",
      "^(uv (pip install|add|tool install|tool run)|uvx)(\\s|$)",
      "^poetry (add|install|update|run)(\\s|$)",
      "^conda (install|create)(\\s|$)",
      "^mamba install(\\s|$)",
      "^pdm (add|install|update|remove|run)(\\s|$)",
      "^(aria2c|axel)(\\s|$)",
      "^(apt(-get|-cache)?|dpkg|snap|flatpak|brew|port)(\\s|$)",
      "^(nmap|tcpdump|tshark|wireshark)(\\s|$)",
      "^(at|batch|atq|atrm)(\\s|$)",
      "^(strace|ltrace)\\s",
      "^history(\\s|$)"
    ]
  },
  "ask": {
    "Write|Edit|MultiEdit|NotebookEdit": ["/?\\.agents/", "/?\\.claude/(?!tmp/)", "/?\\.github/"],
    "Bash": [
      "^git (-C ['\\\"]?\\S+['\\\"]? )*(add|commit|push)(\\s|$)",
      "^(curl|wget)\\s",
      "^(tee|xargs)(\\s|$)",
      "^mlr\\s",
      "^chmod +x\\s",
      "^node (-[ep]|--eval)\\s",
      "^(uv run )?python3? -c\\s",
      "^sh(\\s|$)",
      "^bash(\\s|$)",
      "^uv (run|sync)(\\s|$)",
      "^perl -[eE]\\s",
      "^npx (-y )?(tsx|skills)(@latest)?\\s",
      "^(in2csv|csvsql|sql2csv)(\\s|$)",
      "^printenv(\\s|$)",
      "^journalctl(\\s|$)",
      "^lsof(\\s|$)"
    ]
  }
}
