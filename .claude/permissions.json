{
  "$schema": "~/.claude/plugins/tool-permissions/hooks/tool-permissions/permissions.schema.json",
  "version": 1,
  "deny": {
    "Write|Edit|MultiEdit|NotebookEdit": [
      "^{project}/.*\\.csv$",
      "^{project}/.*\\.svg$"
    ],
    "Read|Write|Edit|MultiEdit|NotebookEdit": [
      "^{project}/(?:.*/)?\\.env[^/]*$",
      "^{project}/(?:.*/)?__pycache__(/|$)",
      "^{project}/(?:.*/)?node_modules(/|$)"
    ]
  }
}
