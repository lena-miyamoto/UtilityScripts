{
  "$schema": "~/.claude/plugins/tool-permissions/hooks/tool-permissions/permissions.schema.json",
  "version": 1,
  "allow": {
    "Bash": [
      "^uv run ruff check\\s",
      "^uv run rumdl check(\\s|$)",
      "^uv lock --check$",
      "^(?:(sh|bash) -n)?\\.claude/scripts/bwrap-pytest\\.sh(\\s|$)",
      "^uv run test(\\s|$)"
    ],
    "Skill": ["^write-unit-test$"]
  },
  "deny": {
    "Edit": ["^{project-dir}/.*\\.csv$", "^{project-dir}/.*\\.svg$"],
    "Read|Edit": [
      "^{project-dir}/(?:.*/)?\\.env[^/]*$",
      "^{project-dir}/(?:.*/)?__pycache__(/|$)",
      "^{project-dir}/(?:.*/)?node_modules(/|$)"
    ]
  },
  "ask": {
    "Bash": [
      "^uv run pytest(\\s|$)",
      "^pytest(\\s|$)",
      "^python -m pytest(\\s|$)",
      "^python3 -m pytest(\\s|$)",
      "^uv run --project .* pytest(\\s|$)"
    ]
  }
}
